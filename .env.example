# Copy to .env; do not commit actual keys.
MIXER_API_KEYS=
# Optional exact HTTP dashboard origins, comma-separated; no path or trailing slash.
# Leave empty for the default HTTPS/loopback policy. See docs/openfrp.md.
MIXER_DASHBOARD_HTTP_ORIGINS=
MIXER_WEB_ENABLED=true
MIXER_WEB_ALLOW_REMOTE_IMAGES=false
MIXER_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_WEB_PROXY=
# Optional container path to a separately mounted, read-only JSON config.
GEMINI_WEB2API_CONFIG=
# Optional Web account pool; compose.web-pool.yml sets the container manifest path.
# For a direct Python launch, set GEMINI_WEB_ACCOUNTS_FILE to your private manifest.
# Leave it empty to keep the existing single-account Web configuration.
GEMINI_WEB_ACCOUNTS_FILE=
GEMINI_WEB_ACCOUNTS_DIR_HOST=./auth/web-accounts
# Per-account 429 cooldown in seconds, integer 1..86400; see docs/web-account-pool.md.
GEMINI_WEB_RATE_LIMIT_COOLDOWN_SEC=300
# Build Executor's public API transport, implemented on the server.
BUILD_API_KEY=
BUILD_MODELS=gemini-2.5-flash
# Public API alternative to Playground; no MakerSuite/WAA bridge.
AIS_API_KEY=
AIS_MODELS=gemini-2.5-flash
# Optional pure-Go AI Studio session backend: compose.aistudio.yml.
# The overlay selects aistudio-http; without it these profiles remain public-api.
AIS_TRANSPORT=public-api
BUILD_TRANSPORT=public-api
AISTUDIO_HTTP_API_KEY=
AISTUDIO_ADMIN_USERNAME=mixer-admin
AISTUDIO_ADMIN_PASSWORD=
AISTUDIO_DATA_DIR=./auth/aistudio-http
AISTUDIO_EVIDENCE_FILE=./auth/aistudio-http/evidence.json
AISTUDIO_HTTP_EVIDENCE_MAX_AGE_SEC=604800
AISTUDIO_LOCAL_PORT=18084
AISTUDIO_ROUTING_STRATEGY=round-robin
AISTUDIO_WARM_WORKER_LIMIT=1
AISTUDIO_MAX_ACTIVE_WORKERS=1
AISTUDIO_PER_ACCOUNT_CONCURRENCY=1
AISTUDIO_GO_MEMORY_LIMIT=256MiB
AISTUDIO_MEMORY_LIMIT=512m
AISTUDIO_PROXY=
# Optional self-hosted Sub2API; key must use an Antigravity-only group.
ANTIGRAVITY_BASE_URL=
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_MODELS=
ANTIGRAVITY_GROUP_CONFIRMED=false
ANTIGRAVITY_ALLOW_HTTP=false
ANTIGRAVITY_MODEL_EVIDENCE_HOST_FILE=
# Optional GPT/o-series route through a separate OpenAI-only Sub2API group.
# Public clients continue using MIXER_API_KEYS, never this upstream key.
# Exact IDs from that group's /v1/models; do not invent thinking suffixes.
# Base URL is the upstream gateway root without /v1, never Mixer itself.
MIXER_OPENAI_BASE_URL=
MIXER_OPENAI_API_KEY=
MIXER_OPENAI_MODELS=
MIXER_OPENAI_GROUP_CONFIRMED=false
MIXER_OPENAI_ALLOW_HTTP=false
MIXER_OPENAI_CONNECT_TIMEOUT_SEC=10
MIXER_OPENAI_READ_TIMEOUT_SEC=90
MIXER_OPENAI_TOTAL_TIMEOUT_SEC=180
MIXER_OPENAI_MAX_REQUEST_BYTES=20971520
MIXER_OPENAI_MAX_RESPONSE_BYTES=16777216
MIXER_OPENAI_MAX_SSE_LINE_BYTES=1048576
# Optional account/model quota collector, enabled only with compose.quota.yml.
# This is separate from the inference API key; do not put admin credentials here.
SUB2API_QUOTA_BASE_URL=
SUB2API_QUOTA_ALLOW_HTTP=false
SUB2API_QUOTA_CREDENTIALS_HOST_FILE=
SUB2API_QUOTA_GROUP_ID=4
SUB2API_QUOTA_ACCOUNT_IDS=2
SUB2API_QUOTA_OUTPUT_FILE=/var/lib/mixer-quota/snapshot.json
SUB2API_QUOTA_INTERVAL_SEC=60
ANTIGRAVITY_QUOTA_MAX_AGE_SEC=600
