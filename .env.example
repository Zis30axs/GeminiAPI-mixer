# Copy to .env; do not commit actual keys.
MIXER_API_KEYS=
MIXER_WEB_ENABLED=true
MIXER_WEB_ALLOW_REMOTE_IMAGES=false
MIXER_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_WEB_PROXY=
# Optional container path to a separately mounted, read-only JSON config.
GEMINI_WEB2API_CONFIG=
# Build Executor's public API transport, implemented on the server.
BUILD_API_KEY=
BUILD_MODELS=gemini-2.5-flash
# Public API alternative to Playground; no MakerSuite/WAA bridge.
AIS_API_KEY=
AIS_MODELS=gemini-2.5-flash
# Optional self-hosted Sub2API; key must use an Antigravity-only group.
ANTIGRAVITY_BASE_URL=
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_MODELS=
ANTIGRAVITY_GROUP_CONFIRMED=false
ANTIGRAVITY_ALLOW_HTTP=false
