+			_, encoded, err = EncodeBuildGenerateRequest(request, defaults, false, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var build map[string]any
+			if err := json.Unmarshal(encoded, &build); err != nil {
+				t.Fatal(err)
+			}
+			if got := build["generationConfig"].(map[string]any)["thinkingConfig"].(map[string]any)["thinkingLevel"]; got != name {
+				t.Fatalf("Build wire level=%v", got)
+			}
+		})
+	}
+}
