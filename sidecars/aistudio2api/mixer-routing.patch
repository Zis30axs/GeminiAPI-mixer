 func (service *trackedService) acquireWarmLease(ctx context.Context, selection aistudio.AccountSelection) (*aistudio.AccountLease, error) {
+	var lockErr error
+	selection, lockErr = aistudio.LockMixerSelection(ctx, selection)
+	if lockErr != nil {
