new file mode 100644
index 0000000..2062b5a
--- /dev/null
+++ b/internal/api/mixer_channel.go
@@ -0,0 +1,111 @@
+package api
+
+import (
+	"net/http"
+	"strings"
+	"sync"
+
+	"github.com/Mag1cFall/AIStudio2API/internal/aistudio"
+)
+
+const mixerChannelHeader = "X-Mixer-Upstream-Channel"
+
+// mixerChannelMiddleware runs AFTER API-key authentication. The response headers
+// acknowledge an enforced routing constraint, including on upstream errors; they
+// do not claim that an unsuccessful request reached Google.
+func mixerChannelMiddleware(configuredKeys string, next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		values, present := r.Header[http.CanonicalHeaderKey(mixerChannelHeader)]
+		if !present {
+			next.ServeHTTP(w, r)
+			return
+		}
+		hasKey := false
+		keys := strings.Split(configuredKeys, ",")
+		for index, key := range keys {
+			keys[index] = strings.TrimSpace(key)
+			hasKey = hasKey || keys[index] != ""
+		}
+		if !hasKey || !checkAPIKeyMatches(r, keys) {
+			writeAuthError(w, r)
+			return
+		}
+		if len(values) != 1 || values[0] != "playground" && values[0] != "build" {
+			writeOpenAIError(w, http.StatusBadRequest, "invalid_upstream_channel", "Expected exactly one playground or build channel")
+			return
+		}
+		channel := aistudio.Channel(values[0])
+		w.Header().Set(mixerChannelHeader, string(channel))
+		w.Header().Set("X-Mixer-Channel-Locked", "1")
+		if !mixerChannelRoute(r) {
+			writeOpenAIError(w, http.StatusBadRequest, "unsupported_channel_route", "Channel locking is supported only for model discovery and ordinary generation")
+			return
+		}
+		ctx := aistudio.ContextWithMixerChannel(r.Context(), channel)
+		response := &mixerThinkingResponseWriter{ResponseWriter: w}
+		ctx = aistudio.ContextWithMixerThinkingObserver(ctx, response.observe)
+		next.ServeHTTP(response, r.WithContext(ctx))
+	})
+}
+
+// Generation can start in a choice goroutine. Keep observations separate from
+// the HTTP header map and publish the current validation only when headers commit.
+type mixerThinkingResponseWriter struct {
+	http.ResponseWriter
+	mu          sync.Mutex
+	level       string
+	wroteHeader bool
+}
+
+func (w *mixerThinkingResponseWriter) observe(level string) {
+	w.mu.Lock()
+	w.level = level
+	w.mu.Unlock()
+}
+
+func (w *mixerThinkingResponseWriter) WriteHeader(status int) {
+	if w.wroteHeader {
+		return
+	}
+	w.wroteHeader = true
+	w.mu.Lock()
+	level := w.level
+	w.mu.Unlock()
+	w.Header().Del("X-Mixer-Thinking-Level")
+	w.Header().Del("X-Mixer-Thinking-Validation")
+	if level != "" {
+		w.Header().Set("X-Mixer-Thinking-Level", level)
+		w.Header().Set("X-Mixer-Thinking-Validation", "account-catalog")
+	}
+	w.ResponseWriter.WriteHeader(status)
+}
+
+func (w *mixerThinkingResponseWriter) Write(body []byte) (int, error) {
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	return w.ResponseWriter.Write(body)
+}
+
+func (w *mixerThinkingResponseWriter) FlushError() error {
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	return http.NewResponseController(w.ResponseWriter).Flush()
+}
+
+func (w *mixerThinkingResponseWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+
+func mixerChannelRoute(r *http.Request) bool {
+	if r.Method == http.MethodGet {
+		return r.URL.Path == "/v1/models" || r.URL.Path == "/v1beta/models"
+	}
+	if r.Method != http.MethodPost {
+		return false
+	}
+	if r.URL.Path == "/v1/chat/completions" || r.URL.Path == "/v1/responses" {
+		return true
+	}
+	return strings.HasPrefix(r.URL.Path, "/v1beta/models/") &&
+		(strings.HasSuffix(r.URL.Path, ":generateContent") || strings.HasSuffix(r.URL.Path, ":streamGenerateContent"))
+}
