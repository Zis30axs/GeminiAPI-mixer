+func TestMixerGenerateChecksActualAccountBeforeProtectedTransport(t *testing.T) {
+	for _, channel := range []Channel{ChannelPlayground, ChannelBuild} {
+		t.Run(string(channel), func(t *testing.T) {
+			entry := modelEntry{model: Model{ID: "fixture"}, defaults: GenerationDefaults{ThinkingLevel: true, ThinkingLevels: []int64{3}}}
+			called := false
+			client := &Client{
+				catalogs: map[string]modelCatalog{"selected": {entries: map[string]modelEntry{"fixture": entry}}},
+				protected: ProtectedTransportFunc(func(context.Context, GenerateRequest, RPCRequest) (*RPCResponse, error) {
+					called = true
