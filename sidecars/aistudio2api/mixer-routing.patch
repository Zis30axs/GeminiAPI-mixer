+package api
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/Mag1cFall/AIStudio2API/internal/aistudio"
+)
+
+func TestMixerChannelAuthenticationAndScope(t *testing.T) {
+	for _, test := range []struct {
+		name, key, credential, path string
+		values                      []string
+		status                      int
+		called                      bool
+	}{
+		{"build", " secret ", "secret", "/v1/chat/completions", []string{"build"}, 429, true},
+		{"playground native", "secret", "secret", "/v1beta/models/gemini:streamGenerateContent", []string{"playground"}, 429, true},
+		{"unauthenticated", "secret", "bad", "/v1/chat/completions", []string{"build"}, 401, false},
+		{"empty key denied", "", "", "/v1/chat/completions", []string{"build"}, 401, false},
+		{"duplicate", "secret", "secret", "/v1/chat/completions", []string{"build", "playground"}, 400, false},
+		{"malformed", "secret", "secret", "/v1/chat/completions", []string{"build,playground"}, 400, false},
+		{"unsupported route", "secret", "secret", "/v1/images/generations", []string{"build"}, 400, false},
+		{"missing header preserves behavior", "secret", "secret", "/v1/chat/completions", nil, 429, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			called := false
+			handler := authMiddleware(test.key, mixerChannelMiddleware(test.key, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				called = true
+				want := ""
+				if len(test.values) == 1 {
+					want = test.values[0]
+				}
+				if got := string(aistudio.MixerChannelFromContext(r.Context())); got != want {
+					t.Errorf("channel=%q want=%q", got, want)
+				}
+				w.WriteHeader(429)
+			})))
+			r := httptest.NewRequest(http.MethodPost, test.path, nil)
+			r.Header.Set("Authorization", "Bearer "+test.credential)
+			if test.values != nil {
+				r.Header[http.CanonicalHeaderKey(mixerChannelHeader)] = test.values
+			}
+			w := httptest.NewRecorder()
+			handler.ServeHTTP(w, r)
+			if w.Code != test.status || called != test.called {
+				t.Fatalf("status=%d called=%v", w.Code, called)
+			}
+			if test.called && len(test.values) == 1 {
+				if w.Header().Get(mixerChannelHeader) != test.values[0] || w.Header().Get("X-Mixer-Channel-Locked") != "1" {
+					t.Fatal("missing lock acknowledgment on upstream error")
+				}
+			}
+			if w.Code == 401 && w.Header().Get("X-Mixer-Channel-Locked") != "" {
+				t.Fatal("unauthenticated lock acknowledgment")
+			}
+		})
+	}
+}
+
+func TestMixerThinkingMetadataRequiresActualCatalogValidation(t *testing.T) {
+	for _, test := range []struct {
+		name                        string
+		validate, supported, stream bool
+	}{
+		{"not validated", false, false, false},
+		{"rejected", true, false, false},
+		{"nonstream", true, true, false},
+		{"stream", true, true, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			handler := authMiddleware("secret", mixerChannelMiddleware("secret", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if test.validate {
+					levels := []int64{3}
+					if test.supported {
+						levels = []int64{1, 2, 3}
+					}
+					if err := aistudio.ValidateMixerThinking(r.Context(), aistudio.GenerationConfig{ReasoningEffort: "MEDIUM"}, aistudio.GenerationDefaults{ThinkingLevel: true, ThinkingLevels: levels}); err != nil {
+						w.WriteHeader(http.StatusBadRequest)
+						return
+					}
+				}
+				if test.stream {
+					if err := http.NewResponseController(w).Flush(); err != nil {
+						t.Fatal(err)
+					}
+				}
+				_, _ = w.Write([]byte("synthetic response"))
+			})))
+			r := httptest.NewRequest(http.MethodPost, "/v1beta/models/fixture:generateContent", nil)
+			r.Header.Set("Authorization", "Bearer secret")
+			r.Header.Set(mixerChannelHeader, "playground")
+			w := httptest.NewRecorder()
+			handler.ServeHTTP(w, r)
+			headers := w.Result().Header
+			if test.validate && test.supported {
+				if headers.Get("X-Mixer-Thinking-Level") != "MEDIUM" || headers.Get("X-Mixer-Thinking-Validation") != "account-catalog" {
+					t.Fatal("missing catalog validation metadata")
+				}
+			} else if headers.Get("X-Mixer-Thinking-Level") != "" || headers.Get("X-Mixer-Thinking-Validation") != "" {
+				t.Fatal("unvalidated effort acknowledged")
+			}
+		})
+	}
+}
