+// AuthUser preserves the explicitly selected Google session in a multi-login cookie jar.
+// Legacy isolated-account states omit this field and retain session zero.
+func (s StorageState) AuthUser() (string, error) {
+	extension, _, err := s.AuthExtension()
+	if err != nil {
+		return "", err
+	}
+	return normalizeAuthUser(extension.Source.AuthUser)
+}
+
+func normalizeAuthUser(value string) (string, error) {
+	if value == "" {
+		return "0", nil
+	}
+	if len(value) > 10 || len(value) > 1 && value[0] == '0' {
+		return "", fmt.Errorf("storage state auth_user 必须为规范的非负十进制账号索引")
+	}
+	for _, character := range value {
+		if character < '0' || character > '9' {
+			return "", fmt.Errorf("storage state auth_user 必须为规范的非负十进制账号索引")
+		}
+	}
+	return value, nil
+}
+
+// aiStudioAccountPageURL pins navigation to the same account as the RPC headers.
+func aiStudioAccountPageURL(rawURL string, authUser string) (string, error) {
+	selected, err := normalizeAuthUser(authUser)
+	if err != nil {
+		return "", err
+	}
+	target, err := url.Parse(rawURL)
+	if err != nil || target.Scheme != "https" || target.Host != "aistudio.google.com" || target.User != nil {
+		return "", fmt.Errorf("AI Studio 账号页面必须位于官方 HTTPS origin")
+	}
+	query := target.Query()
+	if query.Has("authuser") && (len(query["authuser"]) != 1 || query.Get("authuser") != selected) {
+		return "", fmt.Errorf("AI Studio 页面尝试切换所选账号")
+	}
+	pathParts := strings.Split(strings.TrimPrefix(target.Path, "/"), "/")
+	if len(pathParts) >= 2 && pathParts[0] == "u" && pathParts[1] != selected {
+		return "", fmt.Errorf("AI Studio 页面尝试切换所选账号")
+	}
+	// Google canonicalizes authuser=N to /u/N/ and removes the query selector.
+	// Re-adding it to that matching path causes a canonical redirect loop.
+	pathSelectsAccount := len(pathParts) >= 2 && pathParts[0] == "u" && pathParts[1] == selected
+	if query.Has("authuser") || selected != "0" && !pathSelectsAccount {
+		query.Set("authuser", selected)
+	}
+	target.RawQuery = query.Encode()
+	return target.String(), nil
+}
