@@ -0,0 +1,51 @@
+package aistudio
+
+import (
+	"context"
+	"fmt"
+)
+
+type mixerChannelKey struct{}
+
+// ContextWithMixerChannel pins ordinary generation to an authenticated caller's
+// channel. It changes routing only; account eligibility and quotas still apply.
+func ContextWithMixerChannel(ctx context.Context, channel Channel) context.Context {
+	return context.WithValue(ctx, mixerChannelKey{}, channel)
+}
+
+func MixerChannelFromContext(ctx context.Context) Channel {
+	channel, _ := ctx.Value(mixerChannelKey{}).(Channel)
+	return channel
+}
+
+// LockMixerSelection is applied again on every scheduling attempt, including
+// account retries. Unsupported Build-only inputs fail instead of changing source.
+func LockMixerSelection(ctx context.Context, selection AccountSelection) (AccountSelection, error) {
+	channel := MixerChannelFromContext(ctx)
+	if channel == "" {
+		return selection, nil
+	}
+	if channel != ChannelPlayground && channel != ChannelBuild {
+		return selection, fmt.Errorf("%w: invalid locked upstream channel", ErrInvalidArgument)
+	}
+	if selection.Method != "generateContent" || channel == ChannelBuild && !generationChannelSelection(selection) {
+		return selection, fmt.Errorf("%w: request cannot use the locked upstream channel", ErrInvalidArgument)
+	}
+	selection.Channel = channel
+	selection.PreferredChannel = ""
+	return selection, nil
+}
+
+// VerifyMixerLease is the final guard immediately before a generation transport
+// is selected. A missing or mismatching lease must never fall back to Playground.
+func VerifyMixerLease(ctx context.Context) error {
+	channel := MixerChannelFromContext(ctx)
+	if channel == "" {
+		return nil
+	}
+	lease, ok := AccountLeaseFromContext(ctx)
+	if !ok || lease.Channel() != channel {
+		return fmt.Errorf("%w: upstream channel lock was not satisfied", ErrInvalidArgument)
+	}
+	return nil
+}
