+	defaults := GenerationDefaults{MaxOutputTokens: 1024, ThinkingLevel: true, ThinkingLevels: []int64{1, 3}}
+	config := GenerationConfig{ReasoningEffort: "medium"}
+	if err := ValidateMixerThinking(context.Background(), config, defaults); err != nil {
+		t.Fatal(err)
+	}
+	wire, err := encodeGenerationConfig(config, defaults)
+	if err != nil || wire[16].([]any)[3] != int64(1) {
+		t.Fatalf("unlocked compatibility changed: %v %v", wire, err)
+	}
+}
