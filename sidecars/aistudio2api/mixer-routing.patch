+func TestMixerThinkingRejectsUnprovenOrRoundedLevels(t *testing.T) {
+	budget := int64(1024)
+	for _, test := range []struct {
+		name, effort string
+		capability   bool
+		levels       []int64
+		budget       *int64
+	}{
+		{"nearest lower is not medium", "medium", true, []int64{1, 3}, nil},
+		{"missing enum list", "low", true, nil, nil},
+		{"missing capability", "low", false, []int64{1}, nil},
+		{"alias max is not exact", "max", true, []int64{3}, nil},
+		{"none is not minimal", "none", true, []int64{4}, nil},
+		{"budget conflicts with level", "low", true, []int64{1}, &budget},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			observed := "previous-account-value"
+			ctx := ContextWithMixerThinkingObserver(ContextWithMixerChannel(context.Background(), ChannelPlayground), func(level string) { observed = level })
+			err := ValidateMixerThinking(ctx, GenerationConfig{ReasoningEffort: test.effort, ThinkingBudget: test.budget}, GenerationDefaults{ThinkingLevel: test.capability, ThinkingLevels: test.levels})
+			if !errors.Is(err, ErrInvalidArgument) || observed != "" {
+				t.Fatalf("error=%v observed=%q", err, observed)
