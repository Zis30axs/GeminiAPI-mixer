+			request := GenerateRequest{Model: "fixture", Contents: []Content{{Role: RoleUser, Parts: []Part{{Text: "synthetic prompt"}}}}, Config: GenerationConfig{ReasoningEffort: name}}
+			for _, channel := range []Channel{ChannelPlayground, ChannelBuild} {
+				observed := ""
+				ctx := ContextWithMixerThinkingObserver(ContextWithMixerChannel(context.Background(), channel), func(value string) { observed = value })
+				if err := ValidateMixerThinking(ctx, request.Config, defaults); err != nil || observed != name {
+					t.Fatalf("validation=%q error=%v", observed, err)
+				}
+			}
+			encoded, err := EncodeGenerateContentRequest(request, defaults, RequestContext{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			var playground []any
+			if err := json.Unmarshal(encoded, &playground); err != nil {
