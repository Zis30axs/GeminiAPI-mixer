+func TestMixerThinkingExactLevelsReachBothWireFormats(t *testing.T) {
+	defaults := GenerationDefaults{MaxOutputTokens: 1024, Thinking: true, ThinkingLevel: true, ThinkingLevels: []int64{1, 2, 3}}
+	for level, name := range map[int64]string{1: "LOW", 2: "MEDIUM", 3: "HIGH"} {
