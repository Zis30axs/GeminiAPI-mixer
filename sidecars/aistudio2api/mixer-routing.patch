+)
+
+func TestMixerCatalogPublishesOnlyObservedThinkingLevels(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		codes  []int64
+		levels []int64
+		want   []string
+	}{
+		{"exact", []int64{1, 25, 52}, []int64{1, 3, 99}, []string{"low", "high"}},
+		{"not inferred", []int64{1, 25, 52}, nil, nil},
+		{"capability required", []int64{1, 25}, []int64{1, 2, 3}, nil},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			row := make([]any, 83)
+			row[0], row[3], row[6], row[7], row[64] = "models/fixture", "Fixture", int64(1024), []string{"generateContent"}, test.codes
+			row[71] = []any{nil, nil, nil, nil, nil, int64(2), test.levels}
+			raw, err := json.Marshal([]any{[]any{row}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			models, err := ParseModels(bytes.NewReader(raw))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := models[0].CapabilityOptions["thinking_levels"]; !reflect.DeepEqual(got, test.want) {
+				t.Fatalf("thinking levels=%v want=%v", got, test.want)
+			}
+		})
+	}
+}
