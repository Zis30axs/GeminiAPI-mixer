+package aistudio
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestMixerChannelDoesNotFallbackDuringQuotaCooldown(t *testing.T) {
+	model := Model{ID: "gemini", Methods: []string{"generateContent"}, Capabilities: map[string]bool{"chat_model": true}}
+	account := &Account{ID: "fixture", Config: AccountConfig{Enabled: true}, State: AccountReady, Models: []Model{model}, modelAccessGeneration: 1}
+	pool := NewAccountPool([]*Account{account}, 1)
+	pool.SetUpstreamChannels([]Channel{ChannelPlayground, ChannelBuild})
+	if err := pool.SetBuildCatalog(account.ID, []Model{model}); err != nil {
+		t.Fatal(err)
+	}
+	ctx := ContextWithMixerChannel(context.Background(), ChannelBuild)
+	selection, err := LockMixerSelection(ctx, AccountSelection{ModelID: model.ID, Method: "generateContent", PreferredChannel: ChannelPlayground})
+	if err != nil {
+		t.Fatal(err)
+	}
+	lease, _, err := pool.TryAcquireFor(ctx, selection)
+	if err != nil || lease == nil || lease.Channel() != ChannelBuild {
+		t.Fatalf("lease=%v err=%v", lease, err)
+	}
+	if err := VerifyMixerLease(ContextWithAccountLease(ctx, lease)); err != nil {
+		t.Fatal(err)
+	}
+	if err := lease.Release(); err != nil {
+		t.Fatal(err)
+	}
+	if err := pool.MarkCooldownIfGeneration(account.ID, ChannelCooldownScope(ChannelBuild, model.ID), 1, time.Now(), time.Now().Add(time.Hour), "fixture quota"); err != nil {
+		t.Fatal(err)
+	}
+	lease, _, err = pool.TryAcquireFor(ctx, selection)
+	if lease != nil {
+		_ = lease.Release()
+		t.Fatal("locked Build fell back during quota cooldown")
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	groups, err := pool.ClassifyCandidates(ctx, selection, []string{account.ID})
+	if err != nil || !groups.Eligible || groups.EarliestCooldown.IsZero() || len(groups.WarmReady)+len(groups.WarmAvailable)+len(groups.StandbyReady) != 0 {
+		t.Fatalf("quota cooldown was not preserved: %+v err=%v", groups, err)
+	}
+	if pool.AccountChannelAvailable(account.ID, selection) {
+		t.Fatal("alternate channel bypassed lock")
+	}
+	plain, _, err := pool.TryAcquireFor(context.Background(), AccountSelection{ModelID: model.ID, Method: "generateContent"})
+	if err != nil || plain == nil || plain.Channel() != ChannelPlayground {
+		t.Fatalf("unlocked Playground should remain available: %v", err)
+	}
+	defer plain.Release()
+	if VerifyMixerLease(ContextWithAccountLease(ctx, plain)) == nil {
+		t.Fatal("mismatching transport lease accepted")
+	}
+}
+
+func TestMixerChannelRejectsIncompatibleBuildInputs(t *testing.T) {
+	ctx := ContextWithMixerChannel(context.Background(), ChannelBuild)
+	for _, selection := range []AccountSelection{
+		{ModelID: "gemini", Method: "generateContent", ResourceID: "drive-file"},
+		{ModelID: "gemini", Method: "generateContent", PlaygroundOnly: true},
+		{ModelID: "gemini", Method: "countTokens"},
+	} {
+		if _, err := LockMixerSelection(ctx, selection); !errors.Is(err, ErrInvalidArgument) {
+			t.Fatalf("selection=%+v err=%v", selection, err)
+		}
+	}
+	if VerifyMixerLease(ctx) == nil {
+		t.Fatal("missing transport lease accepted")
+	}
+	pool := NewAccountPool(nil, 1)
+	pool.SetUpstreamChannels([]Channel{ChannelPlayground})
+	selection, _ := LockMixerSelection(ctx, AccountSelection{ModelID: "gemini", Method: "generateContent"})
+	if len(pool.selectionChannelsLocked(selection)) != 0 {
+		t.Fatal("disabled Build silently switched source")
+	}
+}
