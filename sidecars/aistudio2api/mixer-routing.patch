@@ -0,0 +1,53 @@
+package aistudio
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"strings"
+)
+
+var catalogThinkingLevelNames = map[int64]string{1: "low", 2: "medium", 3: "high", 4: "minimal"}
+
+type mixerThinkingObserverKey struct{}
+
+// ContextWithMixerThinkingObserver reports only validation against the selected
+// account's catalog. It is not an acknowledgment from Google of execution effort.
+func ContextWithMixerThinkingObserver(ctx context.Context, observer func(string)) context.Context {
+	return context.WithValue(ctx, mixerThinkingObserverKey{}, observer)
+}
+
+func reportMixerThinkingValidation(ctx context.Context, level string) {
+	if observer, ok := ctx.Value(mixerThinkingObserverKey{}).(func(string)); ok && observer != nil {
+		observer(level)
+	}
+}
+
+// ValidateMixerThinking prevents the upstream compatibility layer from silently
+// dropping or rounding an explicit level for source-locked Mixer requests.
+// The caller must provide the actual leased account's freshly selected defaults.
+func ValidateMixerThinking(ctx context.Context, config GenerationConfig, defaults GenerationDefaults) error {
+	if MixerChannelFromContext(ctx) == "" {
+		return nil
+	}
+	reportMixerThinkingValidation(ctx, "")
+	effort := strings.ToLower(strings.TrimSpace(config.ReasoningEffort))
+	if effort == "" || effort == "thinking_level_unspecified" {
+		return nil
+	}
+	var requested int64
+	for level, name := range catalogThinkingLevelNames {
+		if effort == name {
+			requested = level
+			break
+		}
+	}
+	if requested == 0 || !defaults.ThinkingLevel || !slices.Contains(defaults.ThinkingLevels, requested) {
+		return fmt.Errorf("%w: thinking level is not explicitly supported by the selected account model catalog", ErrInvalidArgument)
+	}
+	if config.ThinkingBudget != nil {
+		return fmt.Errorf("%w: a locked thinking level cannot be combined with a thinking budget", ErrInvalidArgument)
+	}
+	reportMixerThinkingValidation(ctx, strings.ToUpper(effort))
+	return nil
+}
